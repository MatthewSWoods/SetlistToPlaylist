@using SetlistToPlaylist.Web.Clients
@inject SetlistToPlaylistApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="navbar-brand">SetlistToPlaylist</div>
    @if (IsAuthenticated)
    {
        <button class="btn-logout" @onclick="LogoutAsync">Logout</button>
    }
</div>

@code {
    [CascadingParameter]
    public bool IsAuthenticated { get; set; }

    private async Task LogoutAsync()
    {
        await ApiClient.LogoutAsync();
        // Clear the client key from session storage
        await JS.InvokeVoidAsync("authHelpers.clearClientKey");
        // Refresh the page to reset the authentication state
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
