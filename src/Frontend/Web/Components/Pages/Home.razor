@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using SetlistToPlaylist.Backend.Modules.Spotify.Abstractions.Models
@using SetlistToPlaylist.Web.Clients
@inject SetlistToPlaylistApiClient ApiClient
@inject NavigationManager Navigation
@inject IHttpMessageHandlerFactory MessageHandlerFactory
@implements IAsyncDisposable

<PageTitle>Setlist to Playlist</PageTitle>

<div class="container" style="max-width: 720px; margin: 2rem auto; font-family: sans-serif;">
    <h1>Setlist &rarr; Playlist</h1>
    <p>Convert a Setlist.fm setlist into a Spotify playlist.</p>

    @if (!_isAuthenticated)
    {
        <div style="margin: 1.5rem 0; padding: 1rem; background: #f5f5f5; border-radius: 6px;">
            <p>You need to connect your Spotify account first.</p>
            <a href="/auth/login" class="btn-primary">Login with Spotify</a>
        </div>
    }
    else
    {
        <div style="margin-bottom: 1rem;">
            <label for="setlistUrl" style="display:block; margin-bottom: .4rem; font-weight: 600;">
                Setlist.fm URL
            </label>
            <input id="setlistUrl"
                   type="url"
                   @bind="_setlistUrl"
                   placeholder="https://www.setlist.fm/setlist/..."
                   disabled="@_isGenerating"
                   style="width: 100%; padding: .5rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 4px;" />
        </div>

        <button @onclick="GenerateAsync"
                disabled="@(_isGenerating || string.IsNullOrWhiteSpace(_setlistUrl))"
                style="padding: .6rem 1.4rem; background: #1db954; color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer;">
            @(_isGenerating ? "Generating…" : "Generate Playlist")
        </button>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="margin-top: 1rem; padding: .8rem; background: #fff0f0; border: 1px solid #f88; border-radius: 4px; color: #c00;">
            @_errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(_playlistUrl))
    {
        <div style="margin-top: 1.5rem; padding: 1rem; background: #f0fff4; border: 1px solid #6c6; border-radius: 6px;">
            <strong>Playlist created!</strong>
            <a href="@_playlistUrl" target="_blank" style="display:block; margin-top: .4rem;">
                Open on Spotify &rarr;
            </a>
        </div>
    }

    @if (_isGenerating || _progressEvents.Count > 0)
    {
        <div style="margin-top: 1.5rem;">
            @if (_total > 0)
            {
                <div style="margin-bottom: .5rem;">
                    <span>@_current / @_total tracks processed</span>
                    <div style="height: 8px; background: #eee; border-radius: 4px; margin-top: .3rem; overflow: hidden;">
                        <div style="height: 100%; background: #1db954; border-radius: 4px; width: @ProgressPercent%; transition: width .3s;"></div>
                    </div>
                </div>
            }
            else if (_isGenerating)
            {
                <p style="color: #888;">Fetching setlist and creating playlist…</p>
            }

            @if (_progressEvents.Count > 0)
            {
                <ul style="list-style: none; padding: 0; margin: .5rem 0; max-height: 300px; overflow-y: auto; border: 1px solid #eee; border-radius: 4px;">
                    @foreach (var evt in _progressEvents)
                    {
                        <li style="padding: .35rem .6rem; border-bottom: 1px solid #f5f5f5; color: @(evt.Type == "track_found" ? "#2a7a2a" : "#b85c00"); font-size: .9rem;">
                            @if (evt.Type == "track_found")
                            {
                                <span>&#10003; @evt.SongName</span>
                            }
                            else
                            {
                                <span>&#8211; @evt.SongName <em style="color: #999;">(not found)</em></span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (_completedEvent is not null)
    {
        <div style="margin-top: 1.5rem; padding: 1rem; background: #f8f8f8; border-radius: 6px;">
            <h3 style="margin-top: 0;">Done!</h3>
            <p>
                <strong>@(_completedEvent.TrackUris?.Length ?? 0)</strong> tracks added &nbsp;|&nbsp;
                <strong>@(_completedEvent.FailedTracks?.Length ?? 0)</strong> not found
            </p>
            @if (_completedEvent.FailedTracks?.Length > 0)
            {
                <details>
                    <summary style="cursor: pointer; color: #888;">Show missing tracks (@_completedEvent.FailedTracks.Length)</summary>
                    <textarea readonly
                              style="width: 100%; margin-top: .5rem; padding: .4rem; font-size: .85rem; border: 1px solid #ddd; border-radius: 4px; height: 120px; resize: vertical;">@string.Join("\n", _completedEvent.FailedTracks)</textarea>
                </details>
            }
        </div>
    }
</div>

@code {
    private HubConnection? _hubConnection;
    private string _setlistUrl = string.Empty;
    private bool _isAuthenticated;
    private bool _isGenerating;
    private string? _errorMessage;
    private string? _playlistUrl;

    private int _current;
    private int _total;
    private readonly List<PlaylistProgressEvent> _progressEvents = [];
    private PlaylistProgressEvent? _completedEvent;

    private int ProgressPercent => _total == 0 ? 0 : (int)Math.Round(_current * 100.0 / _total);

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await ApiClient.IsAuthenticatedAsync();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl("https://apiservice/hubs/playlist", options =>
            {
                // IHttpMessageHandlerFactory provides the Aspire service-discovery-aware
                // handler pipeline. HubConnectionBuilder does not support the https+http://
                // scheme directly, so we route through the named client instead.
                options.HttpMessageHandlerFactory = _ => MessageHandlerFactory.CreateHandler("apiservice-hub");
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<PlaylistProgressEvent>("ReceiveProgress", OnProgressReceived);

        await _hubConnection.StartAsync();
    }

    private async Task GenerateAsync()
    {
        _errorMessage = null;
        _playlistUrl = null;
        _progressEvents.Clear();
        _completedEvent = null;
        _current = 0;
        _total = 0;
        _isGenerating = true;

        var connectionId = _hubConnection?.ConnectionId ?? string.Empty;
        var result = await ApiClient.GeneratePlaylistAsync(_setlistUrl, connectionId, isPublic: false);

        if (result.NeedsAuth)
        {
            Navigation.NavigateTo("/auth/login", forceLoad: true);
            return;
        }

        if (result.Error is not null)
        {
            _errorMessage = result.Error;
            _isGenerating = false;
            StateHasChanged();
            return;
        }

        _playlistUrl = result.PlaylistUrl;
        StateHasChanged();
        // Generating remains true until we receive "completed" or "error" via SignalR
    }

    private void OnProgressReceived(PlaylistProgressEvent evt)
    {
        switch (evt.Type)
        {
            case "track_found":
            case "track_failed":
                _progressEvents.Add(evt);
                _current = evt.Current;
                _total = evt.Total;
                break;
            case "completed":
                _completedEvent = evt;
                _isGenerating = false;
                if (_playlistUrl is null && evt.Playlist is not null)
                    _playlistUrl = evt.Playlist.ExternalUrls.Spotify;
                break;
            case "error":
                _errorMessage = evt.ErrorMessage ?? "An unknown error occurred";
                _isGenerating = false;
                break;
        }

        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
